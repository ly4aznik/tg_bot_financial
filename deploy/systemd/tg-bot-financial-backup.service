[Unit]
Description=SQLite backup for Telegram financial bot
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=%h/apps/tg_bot_financial
Environment=SQLITE_DATABASE_PATH=data/expenses.sqlite3
Environment=SQLITE_BACKUP_DIRECTORY=/mnt/storage/shared/backup/tg_bot_financial
ExecStartPre=/usr/bin/mountpoint --quiet /mnt/storage
ExecStart=/usr/bin/python3 %h/apps/tg_bot_financial/expense_bot/backup.py
Restart=on-failure
RestartSec=1h
TimeoutStartSec=15min
UMask=0077
